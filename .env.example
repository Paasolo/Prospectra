# =============================================================================
# Prospectra environment variables
# Copy to .env and fill values locally. Never commit real secrets.
# Use different values for local, test, staging, and production.
# =============================================================================

# --- Frontend (Vite / Vercel) — public values only ---
# Supabase project URL (safe to expose to the browser)
VITE_SUPABASE_URL=
# Supabase anon / publishable key (RLS-protected; never the service role key)
VITE_SUPABASE_ANON_KEY=
# Public app origin used for OAuth redirects and absolute links
VITE_APP_URL=http://127.0.0.1:5173
# Optional: enable labelled demonstration mode for unconfigured data providers
VITE_DEMO_MODE=false
# Worker origin used for crawl, AI, discovery, and enrichment. Never put provider secrets here.
VITE_WORKER_URL=http://127.0.0.1:8787

# --- Supabase server / worker / Edge Functions ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — worker and Edge Functions only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Worker ---
WORKER_PORT=8787
NODE_ENV=development
# Comma-separated browser origins allowed to call the worker
WORKER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=15000
# Stops a single job if it runs longer than this. The timer is cleared when the job finishes.
WORKER_JOB_TIMEOUT_MS=120000
# Public worker origin used as the OAuth redirect base. Required before connecting Gmail or Microsoft.
WORKER_PUBLIC_URL=http://127.0.0.1:8787
# Encrypts OAuth refresh tokens at rest. Generate a long random value. Worker only.
WORKER_CREDENTIAL_KEY=
# Shared secret expected as Microsoft Graph clientState. Unsigned webhooks are rejected.
WORKER_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:5173

# --- OpenAI (worker only) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional. Sent as the OpenAI-Organization header when set.
OPENAI_ORG_ID=

# --- Payments (worker only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Email OAuth / outbound providers (worker only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Resend API key. Outbound email is not sent when this is empty.
EMAIL_PROVIDER_API_KEY=

# --- Calendar integrations (worker only; falls back to the email OAuth client when empty) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# --- Third-party B2B data providers (discovery / enrichment) ---
# Installed adapters: enrichlayer (LinkedIn company/contact/enrichment; preferred),
# apollo (legacy), and hunter (email verification).
COMPANY_DATA_PROVIDER=enrichlayer
COMPANY_DATA_PROVIDER_API_KEY=
CONTACT_DATA_PROVIDER=enrichlayer
CONTACT_DATA_PROVIDER_API_KEY=
ENRICHMENT_PROVIDER=enrichlayer
ENRICHMENT_PROVIDER_API_KEY=
EMAIL_VERIFICATION_PROVIDER=hunter
EMAIL_VERIFICATION_PROVIDER_API_KEY=

# --- Observability ---
# Reserved. The worker does not send events to Sentry yet. It writes JSON logs and heartbeats.
LOG_LEVEL=info

# --- Playwright ---
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
